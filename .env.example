# ===========================================================================
# Janus Desk configuration
#
# Copy to .env and edit. Everything has a working default except the
# optional API keys - the desk runs fine with none of them set.
# ===========================================================================

ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8000

# ---- storage -------------------------------------------------------------
# On Render, point this at a mounted disk or it vanishes on every deploy.
DB_PATH=./data/janus.db
LOG_DIR=./logs

# ---- capital -------------------------------------------------------------
STARTING_CAPITAL=100000

# ---- the two universes ---------------------------------------------------
EQUITY_UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
CRYPTO_UNIVERSE=BTC-USD

# ---- cadence, seconds ----------------------------------------------------
SCAN_INTERVAL_EQUITY_S=900
SCAN_INTERVAL_CRYPTO_S=900
MANAGE_INTERVAL_S=60
TICK_S=5
INTER_SYMBOL_SLEEP_S=2

# ---- risk ----------------------------------------------------------------
EXECUTE_THRESHOLD=70
RISK_PCT_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_UNDERLYING=1
MAX_NEW_POSITIONS_PER_DAY=6
DAILY_LOSS_LIMIT_PCT=0.05
REENTRY_COOLDOWN_MIN=120
MIN_TRADE_NOTIONAL=25

# ---- exits. These differ by market on purpose: an option premium swings
#      40% in a session, BTC spot does not.
STOP_LOSS_PCT_EQUITY=0.35
TAKE_PROFIT_PCT_EQUITY=0.60
TRAIL_ACTIVATE_PCT_EQUITY=0.30
TRAIL_GIVEBACK_PCT_EQUITY=0.20
MAX_HOLD_HOURS_EQUITY=48

STOP_LOSS_PCT_CRYPTO=0.030
TAKE_PROFIT_PCT_CRYPTO=0.055
TRAIL_ACTIVATE_PCT_CRYPTO=0.025
TRAIL_GIVEBACK_PCT_CRYPTO=0.35
MAX_HOLD_HOURS_CRYPTO=24

FLATTEN_EQUITY_AT_CLOSE=false

# ---- options contract selection -----------------------------------------
TARGET_DTE_MIN=7
TARGET_DTE_MAX=45
MAX_SPREAD_PCT=0.12
MIN_OPEN_INTEREST=250

# ---- network budgets -----------------------------------------------------
HTTP_TIMEOUT_S=15
DATA_CALL_BUDGET_S=20
LLM_CALL_BUDGET_S=20
LLM_CHAIN_BUDGET_S=45
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=900

# ---- switches ------------------------------------------------------------
TRADING_ENABLED=true
EQUITY_ENABLED=true
CRYPTO_ENABLED=true
DRY_RUN=false
# FORCE_REGIME=CRYPTO      # uncomment to pin the desk to one shift

# ---- optional providers. All degrade gracefully when unset. -------------
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

DISCORD_WEBHOOK=
DISCORD_CRITICAL_WEBHOOK=
DASHBOARD_URL=http://localhost:8000
