# ===========================================================================
# Janus Desk configuration
#
# Copy to .env and edit. Everything has a working default except the
# optional API keys - the desk runs fine with none of them set.
# ===========================================================================

ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
PORT=8000

# ---- storage -------------------------------------------------------------
# On Render, point this at a mounted disk or it vanishes on every deploy.
DB_PATH=./data/janus.db
LOG_DIR=./logs

# ---- capital -------------------------------------------------------------
# One shared pool. CRYPTO_MAX_EXPOSURE caps concurrent open crypto MTM
# notional (not a reserved allocation). Closed scalps do not count.
STARTING_CAPITAL=10000
CRYPTO_MAX_EXPOSURE=1000
EQUITY_INSTRUMENT=options
MAX_SINGLE_TRADE_PCT=0.25
# Off by default — see scripts/research_spy_regime_timing.py
MARKET_REGIME_FILTER=false

# ---- the two universes ---------------------------------------------------
# Locked to the canonical ten unless ALLOW_CUSTOM_UNIVERSE=true.
EQUITY_UNIVERSE=NVDA,AAPL,MSFT,AMZN,GOOGL,META,TSLA,SPY,QQQ,IWM
CRYPTO_UNIVERSE=BTC-USD
ALLOW_CUSTOM_UNIVERSE=false

# ---- cadence, seconds ----------------------------------------------------
SCAN_INTERVAL_EQUITY_S=900
SCAN_INTERVAL_CRYPTO_S=900
MANAGE_INTERVAL_S=60
TICK_S=5
INTER_SYMBOL_SLEEP_S=2

# ---- risk ----------------------------------------------------------------
# Score floor for the equity desk. Independent of RISK_PCT_PER_TRADE.
EXECUTE_THRESHOLD=75
# Crypto desk score floor (uncoupled from equity).
EXECUTE_THRESHOLD_CRYPTO=60
# When mark is +this fraction of entry, stop ratchets to that price.
LOCK_IN_PROFIT_PCT=0.20
# Per-trade budget = account equity × this. At $10k, 0.08 → $800 = 8% of
# account at risk per trade. Hard-capped by MAX_SINGLE_TRADE_PCT (25%).
RISK_PCT_PER_TRADE=0.08
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_UNDERLYING=1
MAX_NEW_POSITIONS_PER_DAY=6
DAILY_LOSS_LIMIT_PCT=0.05
REENTRY_COOLDOWN_MIN=120
MIN_TRADE_NOTIONAL=25

# ---- exits. These differ by market on purpose: an option premium swings
#      40% in a session, BTC spot does not.
STOP_LOSS_PCT_EQUITY=0.35
TAKE_PROFIT_PCT_EQUITY=0.60
TRAIL_ACTIVATE_PCT_EQUITY=0.30
TRAIL_GIVEBACK_PCT_EQUITY=0.20
MAX_HOLD_HOURS_EQUITY=48

# Share-mode exits (stock % moves — not option-premium %)
STOP_LOSS_PCT_SHARES=0.025
TAKE_PROFIT_PCT_SHARES=0.050
TRAIL_ACTIVATE_PCT_SHARES=0.020
TRAIL_GIVEBACK_PCT_SHARES=0.35
MAX_HOLD_HOURS_SHARES=48

STOP_LOSS_PCT_CRYPTO=0.030
TAKE_PROFIT_PCT_CRYPTO=0.055
TRAIL_ACTIVATE_PCT_CRYPTO=0.025
TRAIL_GIVEBACK_PCT_CRYPTO=0.35
MAX_HOLD_HOURS_CRYPTO=24

FLATTEN_EQUITY_AT_CLOSE=false

# ---- options contract selection -----------------------------------------
TARGET_DTE_MIN=7
TARGET_DTE_MAX=45
MAX_SPREAD_PCT=0.12
MIN_OPEN_INTEREST=250
# 0.0 = ATM; positive = further OTM. Liquidity floor is not relaxed.
TARGET_MONEYNESS=0.0

# ---- network budgets -----------------------------------------------------
HTTP_TIMEOUT_S=15
DATA_CALL_BUDGET_S=20
LLM_CALL_BUDGET_S=20
LLM_CHAIN_BUDGET_S=45
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=900

# ---- switches ------------------------------------------------------------
TRADING_ENABLED=true
EQUITY_ENABLED=true
CRYPTO_ENABLED=true
DRY_RUN=false
# FORCE_REGIME=CRYPTO      # uncomment to pin the desk to one shift

# ---- optional providers. All degrade gracefully when unset. -------------
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

DISCORD_WEBHOOK=
# DISCORD_WEBHOOK_URL=          # alias accepted if DISCORD_WEBHOOK is empty
DISCORD_CRITICAL_WEBHOOK=
DASHBOARD_URL=http://localhost:8000

# ---- market data ---------------------------------------------------------
# yahoo  — free scrape, high request footprint (~6x)
# alpaca — batched, rate-governed (requires keys). Prefer for paper+live.
MARKET_DATA_PROVIDER=yahoo
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex
# Free Basic options feed. Keep "indicative"; "opra" needs a signed agreement.
ALPACA_OPTIONS_FEED=indicative
ALPACA_RATE_LIMIT_PER_MIN=100
# ALPACA_HARD_LIMIT_PER_MIN=200

# ---- rolling news bias (LLM → float in [-1,1]; MACRO + CRYPTO scopes)
NEWS_ENABLED=true
NEWS_BIAS_WEIGHT=0.15
NEWS_BIAS_TTL_HOURS=1.75
NEWS_REFRESH_INTERVAL_S=1800

# ---- BTC multi-layer scalp (ATR-scaled R, not fixed percentages)
SCALP_ENABLED=true
SCALP_ATR_MULT=1.5
SCALP_TARGET_R=1.8
SCALP_TRAIL_ARM_R=0.8
SCALP_TRAIL_GIVEBACK_PCT=0.35
SCALP_MAX_HOLD_MIN=90
SCALP_VWAP_PERIOD=48
SCALP_MOMENTUM_BARS=6

# ---- free-tier / keep-alive (see DEPLOY.md)
# EPHEMERAL_STORAGE_ACK=true    # required on free Render (no disk)
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL_S=300
